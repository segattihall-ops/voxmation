# Environment variables for the VOXmatiON marketing app
#
# Copy this file to `.env.local` for local dev, and set the same keys in the
# Vercel project (Settings → Environment Variables). All values are server-side
# only — none are exposed to the browser.

# --- ElevenLabs Conversational AI (browser-mic demo) ---
# API key with Conversational AI permissions (Profile → API Keys).
ELEVENLABS_API_KEY=
# The Conversational AI agent ID (top of the agent page).
ELEVENLABS_AGENT_ID=
# Optional: the agent's Twilio media-stream WebSocket URL (wss://...).
# Used only by the call-me-back TwiML bridge. If unset, the call still connects
# but plays a "stream not configured" message.
ELEVENLABS_TWILIO_STREAM_URL=

# --- Twilio (call-me-back demo) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio number the demo call originates from (E.164, e.g. +12145550100).
TWILIO_FROM_NUMBER=

# --- App ---
# Public base URL Twilio uses to fetch TwiML (e.g. https://voxmation.com).
# Must be publicly reachable — for local testing use an ngrok/tunnel URL.
PUBLIC_BASE_URL=
