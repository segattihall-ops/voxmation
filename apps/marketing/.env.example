# Environment variables for the VOXmatiON marketing app
#
# Copy this file to `.env.local` for local dev, and set the same keys in the
# Vercel project (Settings → Environment Variables). All values are server-side
# only — none are exposed to the browser.

# --- ElevenLabs Conversational AI ---
# API key with Conversational AI permissions (Profile → API Keys).
ELEVENLABS_API_KEY=
# The Conversational AI agent ID (top of the agent page).
ELEVENLABS_AGENT_ID=
# The phone-number ID for the Twilio number imported into ElevenLabs
# (Conversational AI → Phone Numbers). Used by the "call me back" route to place
# outbound calls via ElevenLabs' native Twilio integration.
ELEVENLABS_AGENT_PHONE_NUMBER_ID=

# --- Demo booking (Zapier webhook) ---
# The /demo "Book Your Free Demo" form forwards each lead to this Zapier
# "Catch Hook" URL. In Zapier: create a Zap → trigger "Webhooks by Zapier →
# Catch Hook" → copy the custom webhook URL here. Add actions (send email
# confirmation via Gmail, add to CRM, etc.) on the Zapier side. This is the
# only variable required for the form to work.
DEMO_ZAPIER_WEBHOOK_URL=
